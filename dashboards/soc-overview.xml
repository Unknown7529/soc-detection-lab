<form version="1.1" theme="dark">
  <label>SOC Overview</label>
  <description>Ringkasan deteksi lab SOC: brute force, PowerShell encoded, scheduled task, perubahan grup admin</description>
  <fieldset submitButton="false">
    <input type="time" token="t">
      <label>Time range</label>
      <default>
        <earliest>-7d@h</earliest>
        <latest>now</latest>
      </default>
    </input>
  </fieldset>
  <row>
    <panel>
      <title>Failed logon (4625) over time</title>
      <chart>
        <search>
          <query><![CDATA[index=lab_soc source="WinEventLog:Security" EventCode=4625
| timechart count]]></query>
          <earliest>$t.earliest$</earliest>
          <latest>$t.latest$</latest>
        </search>
        <option name="charting.chart">column</option>
      </chart>
    </panel>
    <panel>
      <title>Top source IP (failed logon)</title>
      <table>
        <search>
          <query><![CDATA[index=lab_soc source="WinEventLog:Security" EventCode=4625 Source_Network_Address!="-"
| stats count by Source_Network_Address
| sort - count]]></query>
          <earliest>$t.earliest$</earliest>
          <latest>$t.latest$</latest>
        </search>
      </table>
    </panel>
  </row>
  <row>
    <panel>
      <title>Encoded PowerShell (Sysmon)</title>
      <table>
        <search>
          <query><![CDATA[index=lab_soc source=*Sysmon* EventCode=1 Image="*powershell.exe"
| regex CommandLine="(?i)\s-(e|ec|en|enc|enco\w*|encodedcommand)\s"
| table _time, User, ParentImage, CommandLine]]></query>
          <earliest>$t.earliest$</earliest>
          <latest>$t.latest$</latest>
        </search>
      </table>
    </panel>
  </row>
  <row>
    <panel>
      <title>Scheduled task created (schtasks)</title>
      <table>
        <search>
          <query><![CDATA[index=lab_soc source=*Sysmon* EventCode=1 Image="*schtasks.exe" CommandLine="*/create*"
| table _time, host, User, ParentImage, CommandLine]]></query>
          <earliest>$t.earliest$</earliest>
          <latest>$t.latest$</latest>
        </search>
      </table>
    </panel>
    <panel>
      <title>Member added to Administrators (4732)</title>
      <table>
        <search>
          <query><![CDATA[index=lab_soc source="WinEventLog:Security" EventCode=4732 Group_Name=Administrators
| table _time, host, Member_Security_ID
| sort - _time]]></query>
          <earliest>$t.earliest$</earliest>
          <latest>$t.latest$</latest>
        </search>
      </table>
    </panel>
  </row>
  <row>
    <panel>
      <title>New local accounts (4720)</title>
      <table>
        <search>
          <query><![CDATA[index=lab_soc source="WinEventLog:Security" EventCode=4720
| table _time, New_Account_Account_Name, Account_Name
| sort - _time]]></query>
          <earliest>$t.earliest$</earliest>
          <latest>$t.latest$</latest>
        </search>
      </table>
    </panel>
    <panel>
      <title>Event volume by source (pipeline health)</title>
      <chart>
        <search>
          <query><![CDATA[index=lab_soc
| timechart count by source]]></query>
          <earliest>$t.earliest$</earliest>
          <latest>$t.latest$</latest>
        </search>
        <option name="charting.chart">area</option>
      </chart>
    </panel>
  </row>
</form>